# All variables below are OPTIONAL.
# Orders are placed via WhatsApp with Cash on Delivery. Product data persists
# in the Netlify Database and the admin account is seeded by a migration, so
# the app runs out of the box with no manual configuration.

# ----- SECURITY: Admin credentials ------------------------------
# The admin account lives in the `admin_users` table of the Netlify Database
# and is seeded by the migration `20260901171844_seed_admin_user`. To change
# the admin password, generate a new PBKDF2-SHA256 hash and insert/update the
# row (plaintext is never stored):
#
#   node scripts/hash-admin-password.mjs "<new-password>"
#
# Sign in at /auth/login with the configured admin email and password.

# ----- NextAuth ----------------------------------------------
# AUTH_SECRET / NEXTAUTH_SECRET: long random string. If unset, a local
# development fallback is used. Set a real random value in production.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# ----- App ---------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919370549753
NEXT_PUBLIC_STORE_NAME=AP Fashion Mart
