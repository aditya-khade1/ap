# All variables below are OPTIONAL.
# No database is required. The app runs out of the box with local data
# and orders are placed via WhatsApp with Cash on Delivery.

# ----- SECURITY: Admin credentials ------------------------------
# Admin credentials must be provided via environment variables.
# NEVER hardcode or commit passwords. If ADMIN_EMAIL or
# ADMIN_PASSWORD_HASH is missing, admin sign-in is disabled.
#
# 1) Pick a strong password (at least 12 characters, not used anywhere else)
#    and generate its hash:
#
#      npm run hash:admin -- "your-strong-password"
#
# 2) Copy the printed ADMIN_PASSWORD_HASH value below.
#
# Sign in at http://localhost:3000/auth/login
ADMIN_EMAIL=admin@apfashionmart.com
# ADMIN_PASSWORD_HASH=pbkdf2:sha256:310000:<salt-base64>:<hash-base64>

# ----- NextAuth ----------------------------------------------
# AUTH_SECRET / NEXTAUTH_SECRET: long random string. If unset, a local
# development fallback is used. Set a real random value in production.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# ----- App ---------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919370549753
NEXT_PUBLIC_STORE_NAME=AP Fashion Mart
